{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Read|Bash|exec_command|shell_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check-read.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
